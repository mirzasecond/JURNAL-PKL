<div class="auth-col">
  <div class="auth-card">
    <h1>Pemulihan Akses</h1>
    <% if (!sent) { %>
      <p class="sub">Masukkan email akunmu. Kami akan memberikan tautan untuk mengatur ulang kata sandi.</p>
      <form method="post" action="/forgot-password" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field">
          <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
          <input type="email" id="email" name="email" value="<%= values.email || '' %>" required autofocus>
        </div>
        <button type="submit" class="btn btn-primary btn-block" data-busy>Kirim Tautan</button>
      </form>
      <p class="auth-link"><a href="/login">Kembali ke halaman masuk</a></p>
    <% } else { %>
      <div class="alert alert-info" role="status">
        <span>Jika email tersebut terdaftar, tautan pemulihan telah dibuat. Buka tautan di bawah ini untuk mengatur ulang kata sandi.</span>
      </div>
      <% if (token) { %>
        <p class="small muted">Tautan pemulihan:</p>
        <p style="word-break:break-all;"><a href="/reset-password?t=<%= token %>">/reset-password?t=<%= token %></a></p>
        <p class="tiny muted">Tautan berlaku 1 jam. Pada mode produksi, tautan dikirim melalui email.</p>
      <% } %>
      <p class="auth-link"><a href="/login">Kembali ke halaman masuk</a></p>
    <% } %>
  </div>
</div>
