<div class="modal-backdrop" id="confirmModal" role="dialog" aria-modal="true" aria-labelledby="confirmTitle" aria-hidden="true">
  <div class="modal">
    <h3 id="confirmTitle">Konfirmasi</h3>
    <p id="confirmMessage">Apakah Anda yakin?</p>
    <div class="btn-row">
      <button type="button" class="btn btn-outline" data-modal-cancel>Batal</button>
      <button type="button" class="btn btn-danger" data-modal-confirm>Ya, lanjutkan</button>
    </div>
  </div>
</div>
