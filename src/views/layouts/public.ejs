<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../partials/head', { title }) %>
</head>
<body>
  <a class="skip-link" href="#main">Lewati ke konten</a>
  <div class="auth-wrap">
    <header class="topbar">
      <div class="container topbar-inner">
        <a class="brand" href="/"><span class="brand-mark">JP</span> Jurnal PKL</a>
        <div class="spacer"></div>
        <div class="user-menu">
          <% if (me) { %>
            <a class="btn btn-outline btn-sm" href="/dashboard">Dashboard</a>
          <% } else { %>
            <a class="btn btn-ghost btn-sm" href="/login">Masuk</a>
            <a class="btn btn-primary btn-sm" href="/register">Daftar</a>
          <% } %>
        </div>
      </div>
    </header>
    <main id="main" class="public-main"><%- body %></main>
    <footer class="auth-footer">
      &copy; <%= new Date().getFullYear() %> Jurnal PKL — Catat · Pantau · Capai
    </footer>
  </div>
  <script src="/js/app.js" defer></script>
</body>
</html>
