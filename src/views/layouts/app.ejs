<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('../partials/head', { title }) %>
</head>
<body class="app-page">
  <a class="skip-link" href="#main">Lewati ke konten</a>

  <header class="topbar">
    <div class="container topbar-inner">
      <a class="brand" href="/dashboard"><span class="brand-mark">JP</span> <span class="hide-sm">Jurnal PKL</span></a>
      <nav class="topbar-nav" aria-label="Navigasi utama">
        <a href="/dashboard" class="<%= currentPath === '/dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/journals" class="<%= currentPath.startsWith('/journals') ? 'active' : '' %>">Jurnal</a>
        <a href="/progress" class="<%= currentPath === '/progress' ? 'active' : '' %>">Progres</a>
        <a href="/export" class="<%= currentPath === '/export' ? 'active' : '' %>">Laporan</a>
        <a href="/profile" class="<%= currentPath === '/profile' ? 'active' : '' %>">Profil</a>
        <a href="/settings" class="<%= currentPath === '/settings' ? 'active' : '' %>">Pengaturan</a>
      </nav>
      <div class="spacer"></div>
      <div class="user-menu">
        <% if (me && me.profilePhoto) { %>
          <img class="avatar" src="/profile-photo" alt="Foto profil <%= me.fullName %>">
        <% } else { %>
          <span class="avatar" aria-hidden="true"><%= me && me.initials ? me.initials : 'S' %></span>
        <% } %>
      </div>
    </div>
  </header>

  <main id="main" class="container page">
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'error' : flash.type === 'info' ? 'info' : 'success' %>" role="status">
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
        <span><%= flash.message %></span>
      </div>
    <% } %>
    <%- body %>
  </main>

  <nav class="bottomnav" aria-label="Navigasi utama">
    <a href="/dashboard" class="<%= currentPath === '/dashboard' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
      <span>Home</span>
    </a>
    <a href="/journals" class="<%= currentPath.startsWith('/journals') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      <span>Jurnal</span>
    </a>
    <a href="/journals/new" class="bn-add" aria-label="Tambah jurnal">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      <span>Tambah</span>
    </a>
    <a href="/progress" class="<%= currentPath === '/progress' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 3v18h18"/><path d="M7 15l4-6 3 4 5-8"/></svg>
      <span>Progres</span>
    </a>
    <a href="/export" class="<%= currentPath === '/export' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M5 21h14"/></svg>
      <span>Laporan</span>
    </a>
    <a href="/settings" class="<%= currentPath === '/settings' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33h0a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51h0a1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82v0a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
      <span>Setelan</span>
    </a>
  </nav>

  <%- include('../partials/confirm-modal') %>
  <script src="/js/app.js" defer></script>
</body>
</html>
