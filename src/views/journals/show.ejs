<%
  const fmt = (iso) => {
    if (!iso) return '-';
    const d = new Date(iso + 'T00:00:00');
    if (isNaN(d)) return iso;
    return d.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  };
  const fmtDT = (s) => {
    if (!s) return '-';
    const d = new Date(s.replace(' ', 'T') + 'Z');
    if (isNaN(d)) return s;
    return d.toLocaleString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Jakarta' });
  };
%>
<div class="page-head">
  <div class="grow">
    <h1>Detail Jurnal</h1>
    <p class="sub">Dibuat <%= fmtDT(journal.created_at) %><%= journal.updated_at !== journal.created_at ? ' · diperbarui ' + fmtDT(journal.updated_at) : '' %></p>
  </div>
  <a class="btn btn-ghost" href="/journals">← Riwayat</a>
</div>

<div class="card">
  <div class="detail-meta">
    <span class="badge"><%= fmt(journal.activity_date) %></span>
    <% if (journal.start_time) { %><span class="badge badge-muted"><%= journal.start_time %><%= journal.end_time ? ' – ' + journal.end_time : '' %></span><% } %>
  </div>
  <h2 class="detail-title"><%= journal.title %></h2>

  <div class="detail-section mt-2">
    <h3>Deskripsi Kegiatan</h3>
    <p class="prose"><%= journal.description %></p>
  </div>

  <% if (journal.result) { %>
    <div class="detail-section">
      <h3>Hasil Kegiatan</h3>
      <p class="prose"><%= journal.result %></p>
    </div>
  <% } %>

  <% if (journal.obstacles) { %>
    <div class="detail-section">
      <h3>Kendala</h3>
      <p class="prose"><%= journal.obstacles %></p>
    </div>
  <% } %>

  <% if (journal.solutions) { %>
    <div class="detail-section">
      <h3>Solusi</h3>
      <p class="prose"><%= journal.solutions %></p>
    </div>
  <% } %>
</div>

<div class="card">
  <div class="card-head">
    <h2 class="grow">Foto Dokumentasi</h2>
    <span class="badge badge-muted"><%= photos.length %> / <%= maxPhotos %></span>
  </div>
  <% if (photos.length === 0) { %>
    <p class="muted small mb-2">Belum ada foto. Tambahkan bukti dokumentasi kegiatan di bawah ini.</p>
  <% } else { %>
    <div class="photo-grid mb-2" id="photoGrid">
      <% photos.forEach(p => { %>
        <figure data-photo-id="<%= p.id %>">
          <a href="/photos/<%= p.id %>" target="_blank" rel="noopener">
            <img src="/photos/<%= p.id %>" alt="<%= p.caption || 'Foto dokumentasi jurnal' %>" loading="lazy">
          </a>
          <% if (p.caption) { %><figcaption><%= p.caption %></figcaption><% } %>
          <button type="button" class="photo-del" data-delete-photo="<%= p.id %>" aria-label="Hapus foto">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l8 8M14 6l-8 8"/></svg>
          </button>
        </figure>
      <% }) %>
    </div>
  <% } %>
  <div id="photoManager" data-journal-id="<%= journal.id %>" data-csrf="<%= csrf %>" data-max="<%= maxPhotos %>" data-max-size-mb="<%= maxSizeMb %>" data-count="<%= photos.length %>">
    <% if (photos.length >= maxPhotos) { %>
      <div class="alert alert-info mb-0">
        <span>Batas <%= maxPhotos %> foto untuk jurnal ini sudah tercapai. Hapus salah satu foto di atas jika ingin menggantinya.</span>
      </div>
    <% } else { %>
      <div class="dropzone" id="dropzone">
        <input type="file" id="photoInput" accept="image/jpeg,image/png,image/webp" multiple hidden>
        <p class="mb-1 dz-text"><strong>Tambah foto</strong> — pilih berkas atau seret ke sini</p>
        <p class="hint mb-0">JPG, PNG, atau WebP · maksimal <%= maxSizeMb %> MB per foto · maksimal <%= maxPhotos %> foto (sisa <%= maxPhotos - photos.length %> slot)</p>
        <button type="button" class="btn btn-outline btn-sm mt-2" id="pickPhoto">Pilih Foto</button>
      </div>
      <div class="upload-status" id="uploadStatus" role="status" aria-live="polite"></div>
    <% } %>
  </div>
</div>

<div class="btn-row mt-2">
  <a class="btn btn-primary" href="/journals/<%= journal.id %>/edit">Edit Jurnal</a>
  <form method="post" action="/journals/<%= journal.id %>/delete" style="display:contents;">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button type="submit" class="btn btn-danger-soft" data-confirm data-confirm-title="Hapus jurnal ini?" data-confirm-message="Jurnal &quot;<%= journal.title %>&quot; beserta fotonya akan dihapus secara permanen.">Hapus Jurnal</button>
  </form>
</div>
