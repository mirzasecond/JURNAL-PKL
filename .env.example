# Salin file ini menjadi .env dan sesuaikan nilainya. JANGAN commit .env.

# Lingkungan: production membuat cookie aman & cache aset aktif
NODE_ENV=production

# Port internal aplikasi (di belakang nginx)
PORT=3000

# Lokasi database SQLite dan folder unggahan (disarankan absolute path)
DATA_DIR=/opt/jurnalpkl/data
UPLOAD_DIR=/opt/jurnalpkl/data/uploads
